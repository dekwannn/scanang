# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.
# Dapatkan API key gratis di https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# Nama model Gemini Flash (cek nama terbaru di AI Studio)
GEMINI_MODEL=gemini-3.5-flash
# Model cadangan (dipisah koma), dipakai otomatis bila model utama penuh/lambat
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
